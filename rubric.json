{
  "_comment": "Framework parameters (Tables 24-27 of PIA02). Every editable threshold or weight lives here, not in the code.",
  "subcharacteristic_weights": {
    "Testability": 0.30,
    "Analyzability": 0.24,
    "Modularity": 0.24,
    "Modifiability": 0.22
  },
  "partial_min_fraction": 0.5,
  "level_score": { "Meets": 1.0, "Partial": 0.5, "Fails": 0.0 },
  "level_severity": { "Meets": "None", "Partial": "Medium", "Fails": "High" },
  "points": {
    "layers":        { "name": "Separation of responsibilities between layers", "category": "Structure and modularity", "subcharacteristics": ["Modularity"], "type": "Automatable" },
    "cyclomatic":    { "name": "Cyclomatic complexity", "category": "Structure and modularity", "subcharacteristics": ["Modularity", "Modifiability"], "type": "Automatable" },
    "cohesion":      { "name": "Cohesion of modules with shared responsibility", "category": "Structure and modularity", "subcharacteristics": ["Modularity", "Modifiability"], "type": "Mixed" },
    "hierarchies":   { "name": "Depth and breadth of inheritance or composition hierarchies", "category": "Structure and modularity", "subcharacteristics": ["Modularity"], "type": "Automatable" },
    "technologies":  { "name": "Technology/framework selection and obsolescence risk", "category": "Dependencies and integration", "subcharacteristics": ["Analyzability", "Modifiability"], "type": "Manual" },
    "coupling":      { "name": "External coupling and volume of declared dependencies", "category": "Dependencies and integration", "subcharacteristics": ["Modularity"], "type": "Automatable" },
    "data_model":    { "name": "Data model design", "category": "Dependencies and integration", "subcharacteristics": ["Modularity", "Analyzability"], "type": "Mixed",
                       "criteria": {
                         "C1": "Every table has a primary key and every relation is a declared foreign key (no implicit *_id columns)",
                         "C2": "Normalization consistent with access (up to 3NF; denormalization justified)",
                         "C3": "Integrity constraints declared in the schema (NOT NULL, UNIQUE, CHECK, appropriate types): at least {constraints_min_pct:.0f}% of the columns constrained and no FLOAT for money",
                         "C4": "Indexes on foreign key columns and on the fields the code filters by",
                         "C5": "No unjustified redundancy or inconsistent types (same column name with different types)",
                         "C6": "The declared entity-relationship model matches the implemented schema"
                       } },
    "contracts":     { "name": "Definition of communication contracts between components", "category": "Dependencies and integration", "subcharacteristics": ["Modularity", "Testability"], "type": "Mixed" },
    "observability": { "name": "Presence and consistency of observability mechanisms", "category": "Cross-cutting quality", "subcharacteristics": ["Analyzability"], "type": "Mixed" },
    "tests":         { "name": "Test coverage and design", "category": "Cross-cutting quality", "subcharacteristics": ["Testability"], "type": "Automatable" },
    "configuration": { "name": "Separation of configuration and code", "category": "Cross-cutting quality", "subcharacteristics": ["Modifiability"], "type": "Automatable" }
  },
  "thresholds": {
    "layers": { "meets_max_violations_pct": 0.0, "partial_max_violations_pct": 5.0, "min_identifiable_layers": 2 },
    "cyclomatic": { "function_threshold": 20, "meets_X_min": 0.98, "partial_X_min": 0.95 },
    "cohesion": { "fanout_max": 5, "pct_fanout_max": 5.0, "DL_min": 0.60, "god_loc_min": 300, "god_fanin_min": 8 },
    "hierarchies": { "depth_max": 7, "children_max": 10 },
    "technologies": { "pct_major_outdated_max": 20.0, "vuln_high_critical_max": 0 },
    "coupling": { "outgoing_deps_max": 10, "X_min": 0.90, "PC_max": 0.20, "pct_unused_max": 10.0, "include_devdependencies": false },
    "cognitive": { "_comment": "Informational (does not change the level). SonarSource reference threshold for S3776: 15 per function.", "function_threshold": 15 },
    "dead_code": { "_comment": "Informational. Production files that no other file imports and that are not entry points.", "entry_points": ["index", "server", "app", "main", "App", "setupTests", "reportWebVitals"] },
    "supplementary": { "_comment": "Informational (do not change any level). Reference values from common practice, not from our own study.", "test_ratio_min": 0.3, "jsdoc_min_pct": 50.0, "component_loc_max": 150, "component_props_max": 5, "contract_fields_min_pct": 80.0 },
    "duplication": { "_comment": "Informational (does not change any point's level). Reference threshold: 5% duplicated lines, a widespread practice (SonarQube).", "pct_max": 5.0, "min_lines": 5, "min_tokens": 50 },
    "data_model": { "_comment": "C3: minimum % of non-primary-key columns that declare some constraint (NOT NULL, UNIQUE, CHECK or FOREIGN KEY). C4: maximum % of distinct code query filters that no index can serve. Both values are carried over from the Mongo version of the rubric and have not been calibrated for relational schemas.", "constraints_min_pct": 50.0, "unindexed_queries_max_pct": 0.0 },
    "contracts": { "coverage_min": 90.0 },
    "observability": { "X_min": 0.80 },
    "tests": { "lines_min": 70.0, "branches_min": 50.0 },
    "configuration": {
      "cwe1051_ignore_env_fallback": false,
      "_dup_literal": "CWE-1052 via SonarQube rule S1192 (eslint-plugin-sonarjs no-duplicate-string): threshold 3, minimum length 10, no ^\\w*$ literals, ignores 'application/json'. Verified against the plugin source code on 2026-10-13; the rules.sonarsource.com page could not be consulted.",
      "dup_literal_threshold": 3,
      "dup_literal_min_len": 10,
      "dup_literal_ignore_word_only": true,
      "dup_literal_ignore": ["application/json"]
    }
  },
  "default_layers": {
    "_comment": "Directory heuristic. Can be overridden per application with <app>/.layers.json or --layers. Order = matching priority.",
    "presentation": ["routes", "route", "controllers", "controller", "handlers", "api", "middlewares", "middleware", "views"],
    "business": ["services", "service", "usecases", "use-cases", "domain", "core", "business", "logic"],
    "data": ["repositories", "repository", "repos", "dao", "models", "model", "schemas", "db", "database", "persistence", "entities"],
    "shared": ["utils", "util", "helpers", "lib", "shared", "common", "config", "constants", "types", "errors", "validators"],
    "ambiguous": ["domain", "core", "entities"],
    "_ambiguous": "Directories whose layer depends on the architecture (e.g. 'domain' in DDD is the core, not 'business' in N-tier). A violation that depends on them stays pending manual review (layers.C2) or a .layers.json.",
    "allowed": [["presentation", "business"], ["business", "data"]]
  },
  "supported_runtimes": {
    "_comment": "VERIFY against each project's official pages before freezing the experiment: these major versions are a working assumption, not a verified fact. node/react/express/postgresql are replaced on every run with a network by what endoflife.date reports (eol_products); sequelize and pg have no such source, so only this table applies to them.",
    "date": "2026-10-14",
    "node": [22, 24],
    "react": [18, 19],
    "express": [4, 5],
    "postgresql": [14, 15, 16, 17, 18],
    "sequelize": [6],
    "pg": [8],
    "unverified": {
      "date": "2026-10-26",
      "keys": ["postgresql", "sequelize", "pg"],
      "basis": "postgresql: majors not yet EOL on this date according to endoflife.date (14 reaches EOL on 2026-11-12). sequelize: 6 is the 'latest' npm dist-tag and 7 is still an alpha, as seen on npm on this date. pg: 8 is the 'latest' npm dist-tag on this date. None of this was checked against the projects' own support policies."
    },
    "eol_products": { "node": "nodejs", "react": "react", "express": "express", "postgresql": "postgresql" }
  },
  "relational": {
    "_comment": "Relational schema extraction (relational_schema.py). source_preference: a table is decided entirely by the first source that defines it; lower sources only add tables the higher ones do not mention. type_families/sequelize_types are lookup tables, not a verified mapping of every PostgreSQL type.",
    "source_preference": ["sql", "sequelize_migration", "sequelize_model"],
    "er_model_path": "docs/entity-relationship-model.md",
    "ignore_tables": ["SequelizeMeta", "SequelizeData", "schema_migrations", "knex_migrations", "knex_migrations_lock", "_prisma_migrations", "pgmigrations"],
    "type_families": {
      "integer": ["int", "int2", "int4", "int8", "integer", "smallint", "bigint", "serial", "serial2", "serial4", "serial8", "bigserial", "smallserial", "tinyint", "mediumint"],
      "numeric": ["numeric", "decimal", "money"],
      "float": ["real", "float", "float4", "float8", "double", "double precision"],
      "string": ["varchar", "character varying", "char", "character", "bpchar", "text", "citext", "string", "name"],
      "boolean": ["boolean", "bool"],
      "date": ["date", "dateonly"],
      "timestamp": ["timestamp", "timestamptz", "timestamp with time zone", "timestamp without time zone", "datetime", "time", "timetz", "time with time zone", "time without time zone", "interval"],
      "uuid": ["uuid"],
      "json": ["json", "jsonb"],
      "binary": ["bytea", "blob"],
      "enum": ["enum"],
      "array": ["array"]
    },
    "sequelize_types": {
      "STRING": "varchar(255)", "CHAR": "char(255)", "TEXT": "text", "CITEXT": "citext", "INTEGER": "integer", "BIGINT": "bigint", "SMALLINT": "smallint",
      "TINYINT": "smallint", "MEDIUMINT": "integer", "FLOAT": "float", "REAL": "real", "DOUBLE": "double precision", "DECIMAL": "numeric", "NUMERIC": "numeric",
      "BOOLEAN": "boolean", "DATE": "timestamp with time zone", "DATEONLY": "date", "TIME": "time", "NOW": "timestamp with time zone", "UUID": "uuid",
      "UUIDV4": "uuid", "UUIDV1": "uuid", "JSON": "json", "JSONB": "jsonb", "BLOB": "bytea", "ENUM": "enum", "ARRAY": "array", "INET": "inet", "CIDR": "cidr", "MACADDR": "macaddr"
    },
    "money_name_pattern": "(price|amount|total|cost|balance|subtotal|discount|tax|fee|salary|payment)",
    "implicit_fk_patterns": ["_id$", "[a-z0-9]Id$"],
    "natural_key_names": ["email", "username", "sku", "slug"],
    "boilerplate_columns": ["id", "created_at", "updated_at", "deleted_at", "createdat", "updatedat", "deletedat"],
    "denormalization_words": ["snapshot", "denormaliz", "historic", "at the time", "at time of", "justif", "copy of", "copied"]
  },
  "artifacts": [
    { "id": "source_code", "name": "Source code", "level": "core", "feeds": ["layers", "cyclomatic", "cohesion", "hierarchies"], "evidence": "Structural" },
    { "id": "data_schema", "name": "Data model schema / migrations (SQL, Sequelize migrations or models)", "level": "core", "feeds": ["data_model"], "evidence": "Structural" },
    { "id": "er_model", "name": "Entity-relationship model (docs/entity-relationship-model.md)", "level": "complementary", "feeds": ["data_model"], "evidence": "Declarative" },
    { "id": "manifests", "name": "Manifests and lockfiles", "level": "core", "feeds": ["technologies", "coupling"], "evidence": "Structural" },
    { "id": "test_suite", "name": "Test suite, scripts and coverage report", "level": "complementary", "feeds": ["tests"], "evidence": "Structural", "absence": "high_finding" },
    { "id": "contract_spec", "name": "Contract specification (OpenAPI, JSON Schema, DTOs)", "level": "complementary", "feeds": ["contracts"], "evidence": "Structural" },
    { "id": "config_deploy", "name": "Configuration and deployment (.env.example, Dockerfile, CI)", "level": "complementary", "feeds": ["configuration"], "evidence": "Structural" },
    { "id": "logging_config", "name": "Logging and metrics configuration", "level": "complementary", "feeds": ["observability"], "evidence": "Structural" },
    { "id": "readme_docs", "name": "README, wiki, ADRs", "level": "complementary", "feeds": ["technologies", "data_model", "observability"], "evidence": "Declarative" },
    { "id": "diagrams", "name": "Architecture diagrams", "level": "complementary", "feeds": ["layers", "coupling"], "evidence": "Declarative or derived" },
    { "id": "agent_log", "name": "Agent prompt and session record", "level": "complementary", "feeds": [], "evidence": "Contextual" },
    { "id": "glossary", "name": "Domain glossary or ontology", "level": "optional", "feeds": ["technologies", "data_model", "observability"], "evidence": "Declarative" }
  ],
  "risk_dashboard": {
    "_comment": "Table 29. Semaphore cut-offs apply to the weighted subcharacteristic score (0-100): green >= green_min, yellow >= yellow_min, red below. hotspots_top_n = files listed per automatable indicator.",
    "semaphore": { "green_min": 70.0, "yellow_min": 40.0 },
    "hotspots_top_n": 5
  },
  "libs_logger": ["winston", "pino", "bunyan", "log4js", "loglevel", "roarr"],
  "libs_request_logger": ["morgan", "pino-http", "express-winston", "express-pino-logger", "koa-logger"],
  "libs_metrics": ["prom-client", "express-prom-bundle", "@opentelemetry/api", "@opentelemetry/sdk-node", "dd-trace", "newrelic"],
  "libs_integration_test": ["supertest", "pg-mem", "testcontainers", "@testcontainers/postgresql", "sequelize", "pg"],
  "libs_validation": ["joi", "zod", "express-validator", "celebrate", "yup", "ajv", "class-validator", "express-openapi-validator"]
}
